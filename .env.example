# PostgreSQL settings used by Docker Compose
POSTGRES_DB=student_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Frontend API URL (baked into the Vite production bundle)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Single superuser for the MVP (change this before sharing the deployment)
APP_SUPERUSER_USERNAME=admin
APP_SUPERUSER_PASSWORD=change-me
